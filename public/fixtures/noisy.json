{
  "id": "op-packed",
  "title": "Clinic booking go-live across every partner site, including the ones that still run a paper diary",
  "purpose": "Replace phone booking with a journey patients can complete without calling, including those who need a human path when the digital one fails, and keep clinics able to run a full day of appointments while the change is happening.",
  "endState": {
    "name": "LIVE AND USED",
    "description": "Patients book unassisted. Clinics run the new process. Support is in place. Residual risk is accepted. A human path still exists. Benefits are being tracked month by month.",
    "color": "#5A6A78"
  },
